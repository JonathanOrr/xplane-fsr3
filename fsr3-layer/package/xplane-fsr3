#!/bin/sh
# FSR 3.1 for X-Plane 12 (Linux): starts X-Plane with AMD FSR 3.1 in place of its built-in FSR 1.
#
#   Steam:         X-Plane 12 > Properties > Launch Options:   "/path/to/xplane-fsr3/xplane-fsr3" %command%
#   Without Steam: "/path/to/xplane-fsr3/xplane-fsr3" "/path/to/X-Plane 12/X-Plane-x86_64"
#
# Then use X-Plane's own "Rendering Resolution (FSR Supersampling)" setting as usual.
# Whether FSR 3.1 is active: logs/status.txt next to this script. See README.md.

if [ $# -eq 0 ]; then
    echo "usage: $0 <X-Plane command>   (in Steam's launch options: \"$0\" %command%)" >&2
    exit 2
fi
here=$(cd "$(dirname "$0")" && pwd)

export XP_FSR3="${XP_FSR3:-replace}"

# Logs and status.txt: logs/ here, or ~/.local/state/xplane-fsr3 if this folder is read-only.
if [ -z "$XP_FSR3_OUTPUT" ]; then
    XP_FSR3_OUTPUT="$here/logs"
    if ! mkdir -p "$XP_FSR3_OUTPUT" 2>/dev/null || [ ! -w "$XP_FSR3_OUTPUT" ]; then
        XP_FSR3_OUTPUT="${XDG_STATE_HOME:-$HOME/.local/state}/xplane-fsr3"
    fi
fi
export XP_FSR3_OUTPUT
mkdir -p "$XP_FSR3_OUTPUT" 2>/dev/null
rm -f "$XP_FSR3_OUTPUT/status.txt"
# One log per launch; keep the 10 newest.
ls -1t "$XP_FSR3_OUTPUT"/fsr3-*.jsonl 2>/dev/null | tail -n +11 | while IFS= read -r old; do rm -f "$old"; done

export VK_ADD_LAYER_PATH="$here${VK_ADD_LAYER_PATH:+:$VK_ADD_LAYER_PATH}"
export VK_INSTANCE_LAYERS="VK_LAYER_XPLANE_fsr3${VK_INSTANCE_LAYERS:+:$VK_INSTANCE_LAYERS}"

# Steam runs X-Plane in its Linux runtime, whose Vulkan loader reads VK_ADD_LAYER_PATH. Otherwise the
# system's loader is used, and loaders older than 1.3.211 (e.g. Ubuntu 22.04's 1.3.204) ignore it:
# for those, VK_LAYER_PATH lists this folder plus the standard locations, so other layers still load.
case "$*" in
    *SteamLinuxRuntime*) ;;
    *)
        loader=$(ldconfig -p 2>/dev/null | awk '/libvulkan\.so\.1 .*x86-64/ { print $NF; exit }')
        version=$(readlink -f "$loader" 2>/dev/null | sed -n 's/.*libvulkan\.so\.1\.\([0-9][0-9]*\)\.\([0-9][0-9]*\)$/\1 \2/p')
        minor=${version% *}
        patch=${version#* }
        if [ -z "$version" ] || [ "$minor" -lt 3 ] || { [ "$minor" -eq 3 ] && [ "$patch" -lt 211 ]; }; then
            standard="/usr/local/share/vulkan/explicit_layer.d:/usr/share/vulkan/explicit_layer.d:/etc/vulkan/explicit_layer.d"
            standard="$standard:${XDG_DATA_HOME:-$HOME/.local/share}/vulkan/explicit_layer.d"
            export VK_LAYER_PATH="$here:${VK_LAYER_PATH:-$standard}"
        fi
        ;;
esac

exec "$@"
